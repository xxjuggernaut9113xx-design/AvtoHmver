+fn phar_position_tags(windows: &[ActionWindow]) -> std::collections::BTreeSet<String> {
+    windows
+        .windows(2)
+        .filter_map(|pair| {
+            let a = &pair[0];
+            let b = &pair[1];
+            let label = a.label.trim().to_ascii_lowercase();
